# Environments
.env
.venv/
env/
venv/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# PyInstaller intermediate build dir (the bundle output under dist/ is ignored by dist/.gitignore).
# wifit3.spec IS committed — it's the build config.
build/
dist/
out/


# Project specifics
captures/
driver_sources/
driver_captures*/
kali/
scripts/baseline/*.json
scripts/baseline/history/
scratch/
*.log
# Probe captures (WEP frag/chopchop, WPS, …) — real on-air frames from the
# user's environment; never commit (see no-SSIDs/BSSIDs-in-commits rule).
wifit3*.pcap
scripts/wps/lab_*.pcap
scripts/wps/lab_results.jsonl

# If it starts with a dot, committed it gets not
.*
# ...except the GitHub Actions workflows, which must be tracked (the .* rule hides .github).
!.github/
# ...and the shareable Claude Code assets: skills/commands travel with the repo so anyone who
# clones can run /port. Local settings (settings.local.json, etc.) stay out.
!.claude/
.claude/*
!.claude/skills/
!.claude/commands/
# ...but the /sweep skill is private to this machine (references local APs/config) — keep it local.
.claude/skills/sweep/
